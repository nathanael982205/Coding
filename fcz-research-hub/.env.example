# Kopieren nach .env und Werte eintragen. Die Datei .env niemals committen oder weitergeben.

# KI-Anbieter wählen: anthropic (Claude) oder openai (ChatGPT/GPT-Modelle)
HUB_PROVIDER=anthropic

# Ohne Schlüssel startet die App trotzdem (gespeicherte Analysen bleiben nutzbar).
# Nur der Schlüssel des gewählten Anbieters wird benötigt.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- OpenAI (wenn HUB_PROVIDER=openai) ---
# Modellname wie unter platform.openai.com angegeben
HUB_OPENAI_MODEL=gpt-5.5
# Denktiefe: low | medium | high
HUB_OPENAI_EFFORT=medium
# Max. Antwortlänge pro Anfrage. Bei Fehler 429 (neues Konto, niedriges Limit) auf 16000 senken
HUB_OPENAI_MAX_OUTPUT=32000

# --- Claude (wenn HUB_PROVIDER=anthropic) ---

# Modell und Analysetiefe (low | medium | high | xhigh | max). "high" = gründlich, höhere Kosten.
HUB_CLAUDE_MODEL=claude-opus-5-5
HUB_CLAUDE_EFFORT=high
# Server-seitiger Fallback bei Ablehnungen durch Sicherheitsfilter (true/false)
HUB_REFUSAL_FALLBACK=true

# Parallele KI-Analysen
ANALYSIS_WORKERS=2
# Max. Zeichen PDF-Text pro Studie, die an die KI gehen (fehlende Seiten werden ausdrücklich vermerkt)
MAX_TEXT_CHARS=600000
MAX_UPLOAD_MB=80

# Speicherort für PDFs, Datenbank und Backups (Standard: ./data)
# DATA_DIR=/pfad/zu/meinen/daten

# Nur lokal erreichbar lassen
HOST=127.0.0.1
PORT=8000
